{
  "name": "oldcord",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "frontend/*",
    "oldplunger"
  ],
  "scripts": {
    "build": "npm run build:selector && npm run build:admin && npm run build:oldplunger && npm run build:server",
    "build:admin": "npx rimraf www_static/assets/admin && npm run build --workspace=frontend/admin",
    "build:oldplunger": "npx rimraf www_static/assets/oldplunger && npm run build --workspace=oldplunger",
    "build:selector": "npx rimraf www_static/assets/selector && npm run build --workspace=frontend/selector",
    "build:server": "npx rimraf dist_server && tsc -p server",
    "dev:admin": "npm run dev --workspace=frontend/admin",
    "dev:oldplunger": "npm run dev --workspace=oldplunger",
    "dev:selector": "npm run dev --workspace=frontend/selector",
    "dev:server": "tsx server/index.ts",
    "biome": "npx @biomejs/biome check .",
    "biome:fix": "npx @biomejs/biome check --write .",
    "lint": "npm run biome",
    "lint:fix": "npm run biome:fix",
    "prepare": "husky",
    "format": "npx @biomejs/biome format --write .",
    "start": "npm run build && npm run start:server",
    "start:server": "npm run build:server && node dist_server/index.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sapphire/snowflake": "^3.5.5",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "libsodium-wrappers": "^0.8.4",
    "mediasoup": "^3.23.2",
    "multer": "^2.2.0",
    "murmurhash-js": "^1.0.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-transition-group": "^4.4.5",
    "rimraf": "^6.1.3",
    "semantic-sdp": "^3.31.1",
    "speakeasy": "^2.0.0",
    "ws": "^8.21.1",
    "youtubei.js": "^17.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "optionalDependencies": {
    "erlpack": "^0.1.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
